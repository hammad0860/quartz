{
    "compilerOptions": {
      "target": "es2021",
      "module": "commonjs",
      "lib": ["dom", "esnext"],
      "declaration": true,
      "declarationMap": true,
      "strict": true,
      "pretty": true,
      "sourceMap": true,
      "baseUrl": "./src",
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "resolveJsonModule": true,
      "allowJs": true,
      "outDir": "./dist",
      "jsx": "react-jsx",


    "noEmitOnError": false,           
    "skipLibCheck": true,             
    "noImplicitAny": false,  
    "checkJs": false 

    },
    "include": ["src/**/*.tsx", "src/**/*.ts"],

    "exclude": ["node_modules", "test", "release/build", "release/app/dist", ".erb/dll"]
}  